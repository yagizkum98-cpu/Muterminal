DATABASE_URL=postgresql://muterminal:YOUR_PASSWORD@127.0.0.1:5432/muterminal
# Docker Compose kurulumu için aynı parolayı kullanın.
# MUTERMINAL_POSTGRES_PASSWORD=YOUR_PASSWORD
# MUTERMINAL_POSTGRES_PORT=5432
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=muterminal
MUTERMINAL_SCAN_ENABLED=false
# Vercel veya HTTPS ortamında pilot hesapları yalnızca şifreleri tanımlandığında oluşturulur.
# MUTERMINAL_ADMIN_PASSWORD=
# MUTERMINAL_TESTER_PASSWORD=
# MUTERMINAL_MANAGER_PASSWORD=
# Yalnızca MU TRACE pilot depo hesabını hazırlamak için.
# MUTERMINAL_TRACE_PILOT_WAREHOUSE_PASSWORD=
# MU TRACE pilot firma kapsamındaki salt okunur Denetçi hesabı.
# MUTERMINAL_TRACE_PILOT_AUDITOR_PASSWORD=
# Yalnızca bir kez, tanımlı pilot şifrelerini mevcut hesaplara uygulamak için yeni bir değer verin.
# MUTERMINAL_PILOT_PASSWORD_REVISION=
# İsteğe bağlı MU TRACE platform hesabı.
# MUTERMINAL_TRACE_SUPER_EMAIL=
# MUTERMINAL_TRACE_SUPER_PASSWORD=
# If running behind a reverse proxy, use the exact outer origin.
# MUTERMINAL_PUBLIC_ORIGIN=https://muterminal.example.com
